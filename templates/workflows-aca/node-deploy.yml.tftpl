name: build and deploy

on:
  push:
    branches:
%{ for branch in deploy_branches ~}
      - ${jsonencode(branch)}
%{ endfor ~}

jobs:
  build-deploy:
    uses: bitbool-actions/workflows-aca/.github/workflows/node-build-deploy.yml@${docker_build_deploy_ref}
    permissions:
      contents: read
    with:
      AZURE_ACR_NAME: $${{ vars[format('AZURE_ACR_NAME_{0}', github.ref_name)] }}
      AZURE_ACR_REGISTRY: $${{ vars[format('AZURE_ACR_REGISTRY_{0}', github.ref_name)] }}
      AZURE_ACR_REPO: $${{ vars[format('AZURE_ACR_REPO_{0}', github.ref_name)] }}
      AZURE_SUBSCRIPTION_ID: $${{ vars[format('AZURE_SUBSCRIPTION_ID_{0}', github.ref_name)] }}
      CONTAINER_APP_NAME: $${{ vars[format('CONTAINER_APP_NAME_{0}', github.ref_name)] }}
      RESOURCE_GROUP: $${{ vars[format('RESOURCE_GROUP_{0}', github.ref_name)] }}
      RUNS_ON: $${{ vars[format('RUNS_ON_{0}', github.ref_name)] }}
      PREFIX_SHA_WITH_BRANCH: "true"
      NODE_VERSION: "24"
    secrets:
      AZURE_CLIENT_ID: $${{ secrets[format('AZURE_CLIENT_ID_{0}', github.ref_name)] }}