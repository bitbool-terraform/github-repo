name: build and deploy

on:
  push:
    branches:
      - ${deploy_branch}

jobs:
  build-deploy:
    uses: bitbool-actions/workflows-aca/.github/workflows/docker-build-deploy.yml@main
    permissions:
      contents: read
    with:
      AZURE_ACR_NAME: "${azure_acr_name}"
      AZURE_ACR_REGISTRY: "{azure_acr_registry}"
      AZURE_ACR_REPO: "${azure_acr_repo}"
      PREFIX_SHA_WITH_BRANCH: "true"      
    secrets:
      AZURE_CLIENT_ID: $${{ secrets.AZURE_CLIENT_ID }}