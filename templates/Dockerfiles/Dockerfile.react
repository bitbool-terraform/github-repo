FROM nginx:alpine

RUN echo -e '\n\
    server {\n\
        listen 80;\n\
        root /usr/share/nginx/html;\n\
        index index.html index.htm;\n\
        location / {\n\
            try_files $uri $uri/ /index.html;\n\
        }\n\
        location ~* \.(?:jpg|jpeg|gif|png|ico|cur|gz|svg|svgz|mp4|ogg|ogv|webm|htc)$ {\n\
            try_files $uri =404;\n\
        }\n\
        location ~* \.(?:css|js|json)$ {\n\
            try_files $uri =404;\n\
        }\n\
        # Any route containing a file extension (e.g. /devicesfile.js)\n\
        location ~ ^.+\..+$ {\n\
            try_files $uri =404;\n\
        }\n\
    }\n\
' > /etc/nginx/conf.d/default.conf


COPY build/client/ /usr/share/nginx/html/